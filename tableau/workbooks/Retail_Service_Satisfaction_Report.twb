    <worksheet name='Within SLA by Region'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1F2A37' fontname='Arial' fontsize='12' bold='true'>Within-SLA Ticket Share Proxy by Region</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Service Performance' name='federated.service_tickets' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='federated.service_tickets'>
            <column datatype='string' name='[region]' role='dimension' type='nominal' />
            <column datatype='real' name='[Calculation_Within_SLA_Pct]' role='measure' type='quantitative' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_Within_SLA_Pct]' derivation='User' name='[usr:Calculation_Within_SLA_Pct:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
