            <column-instance column='[opened_date]' derivation='None' name='[none:opened_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[ticket_id]' derivation='CountD' name='[cd:ticket_id:qk]' pivot='key' type='quantitative' />
