    <simple-id uuid="{49332cd7-575b-4a42-a483-753d00de2b3c}" /></worksheet>

    <worksheet name="KPI AOV">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor="#5B6B7C" fontname="Arial" fontsize="10" bold="true">AOV</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Daily Sales by Store" name="federated.daily_sales_store" />
          </datasources>
          <datasource-dependencies datasource="federated.daily_sales_store">
            <column datatype="real" name="[Calculation_AOV]" role="measure" type="quantitative" />
            <column-instance column="[Calculation_AOV]" derivation="User" name="[usr:Calculation_AOV:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
