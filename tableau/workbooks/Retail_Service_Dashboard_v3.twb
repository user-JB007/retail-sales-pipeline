            <encodings>
            </encodings>
          </pane>
        </panes>
        <rows>[federated.service_tickets].[none:region:nk]</rows>
        <cols>[federated.service_tickets].[usr:Calculation_Within_SLA_Pct:qk]</cols>
      </table>
