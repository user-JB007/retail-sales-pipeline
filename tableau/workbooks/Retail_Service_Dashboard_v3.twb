            <column datatype="real" name="[Calculation_Within_SLA_Pct]" role="measure" type="quantitative" />
            <column-instance column="[region]" derivation="None" name="[none:region:nk]" pivot="key" type="nominal" />
            <column-instance column="[Calculation_Within_SLA_Pct]" derivation="User" name="[usr:Calculation_Within_SLA_Pct:qk]" pivot="key" type="quantitative" />
