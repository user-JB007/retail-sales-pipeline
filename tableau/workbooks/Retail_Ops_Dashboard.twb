  <datasource caption="Service Performance" inline="true" name="federated.service_tickets" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="mart_service_performance.csv" name="textscan.service_tickets">
            <connection class="textscan" directory="Data/Datasources" filename="mart_service_performance.csv" password="" server="" />
