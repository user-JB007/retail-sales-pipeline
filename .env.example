# Copy to .env for local overrides (never commit real secrets)

# Force pandas path (recommended for quick demos / CI without Java)
FORCE_PANDAS=1

# Spark (only if using --engine spark)
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g

# Airflow project home when deploying the DAG
RETAIL_PIPELINE_HOME=/path/to/retail-sales-pipeline

# Warehouse connection placeholders (documentation only — do not put real creds here)
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=RETAIL_ANALYTICS
# AZURE_STORAGE_ACCOUNT=
# DATABRICKS_HOST=
