# Copy to .env for local overrides (never commit real secrets)

# Force pandas path (recommended for quick local / CI runs without Java)
FORCE_PANDAS=1

# Spark (only if using --engine spark)
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g

# Airflow project home when deploying the DAG
RETAIL_PIPELINE_HOME=/path/to/retail-sales-pipeline

# API source (Fake Store — leave empty to use config/pipeline.yaml defaults)
API_SOURCE_BASE_URL=
API_HTTP_TIMEOUT=
API_HTTP_RETRIES=

# API sink — local landing service + optional external
SINK_API_URL=http://127.0.0.1:8089/ingest
EXTERNAL_SINK_URL=https://jsonplaceholder.typicode.com/posts

# Warehouse connection variable names (documentation only — do not put real creds here)
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=RETAIL_ANALYTICS
# AZURE_STORAGE_ACCOUNT=
# DATABRICKS_HOST=
