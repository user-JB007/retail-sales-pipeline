-- Retail Sales Pipeline — core DAX measures (Power BI Desktop)
-- Paste into the model after loading gold / sample marts.
-- Prefer fact_daily_store_sales as the primary sales fact unless noted.

-- ===== Sales & volume =====
Net Revenue =
SUM ( fact_daily_store_sales[net_revenue] )

Gross Revenue =
SUM ( fact_daily_store_sales[gross_revenue] )

Gross Profit =
SUM ( fact_daily_store_sales[gross_profit] )

Transactions =
SUM ( fact_daily_store_sales[transactions] )

Units Sold =
SUM ( fact_daily_store_sales[units_sold] )

Discount Total =
SUM ( fact_daily_store_sales[discount_total] )

-- ===== Ratios =====
Avg Order Value =
DIVIDE ( [Net Revenue], [Transactions] )

Gross Margin % =
DIVIDE ( [Gross Profit], [Net Revenue] )

Discount Rate % =
DIVIDE ( [Discount Total], [Gross Revenue] )

-- ===== Time intelligence (requires marked Date table dim_date) =====
Net Revenue MoM % =
VAR Curr = [Net Revenue]
VAR Prev =
    CALCULATE ( [Net Revenue], DATEADD ( dim_date[date], -1, MONTH ) )
RETURN
    DIVIDE ( Curr - Prev, Prev )

Net Revenue YoY % =
VAR Curr = [Net Revenue]
VAR Prev =
    CALCULATE ( [Net Revenue], DATEADD ( dim_date[date], -1, YEAR ) )
RETURN
    DIVIDE ( Curr - Prev, Prev )

Net Revenue MTD =
TOTALMTD ( [Net Revenue], dim_date[date] )

-- ===== Category fact (use on category page) =====
Category Net Revenue =
SUM ( fact_daily_category_sales[net_revenue] )

Category Units =
SUM ( fact_daily_category_sales[units_sold] )

-- ===== Customer LTV =====
Customer Count =
DISTINCTCOUNT ( fact_customer_ltv[customer_id] )

Lifetime Revenue =
SUM ( fact_customer_ltv[lifetime_revenue] )

Avg Customer LTV =
AVERAGE ( fact_customer_ltv[lifetime_revenue] )

Avg Orders per Customer =
AVERAGE ( fact_customer_ltv[order_count] )

-- ===== Product =====
Product Net Revenue =
SUM ( fact_product_performance[net_revenue] )

Product Margin % =
DIVIDE (
    SUM ( fact_product_performance[gross_profit] ),
    SUM ( fact_product_performance[net_revenue] )
)

-- ===== Channel =====
Channel Net Revenue =
SUM ( fact_channel_mix[net_revenue] )

Channel Transactions =
SUM ( fact_channel_mix[transactions] )
